# Copy this file to .env and edit.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/eventra
# MongoDB Atlas (cloud) example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eventra?retryWrites=true&w=majority
PORT=3000
# Any long random text. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-text
